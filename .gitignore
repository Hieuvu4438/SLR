# AutoResearchClaw subfolder
/AutoResearchClaw/

# Large/local assets are never copied into this repository.
/data/
/sign_feature/
/checkpoints/
/third_party/UPRet/
*.pth
*.pt
*.ckpt
*.bin
*.tar.gz
*.zip
*.aria2
*.npy
*.npz

# Third party: ignore checkpoints, datasets, downloads, features, results, local runs, and asset symlinks
/third_party/**/ckpt/
/third_party/**/checkpoints/
/third_party/**/downloads/
/third_party/**/features/
/third_party/**/result_eval/
/third_party/SEDS/datasets/
/third_party/SEDS/CSL
/third_party/SEDS/How2Sign
/third_party/SEDS/PHOENIX-2014-T
/third_party/SEDS/ckpts
/third_party/**/new_experiment/
/third_party/**/chpt/
/third_party/**/sign_feature
/third_party/**/*.log

# Generated experiment artifacts, logs, manifests, features, and checkpoints.
/artifacts/
/runs/
/exports/
/build/
/dist/
/doctor.json
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Docs: allow all markdown files into git, ignore non-md artifacts and raw logs
/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/**/*.pdf
